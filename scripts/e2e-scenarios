#!/usr/bin/env bash
set -Eeuo pipefail

SHARD="${1:?usage: scripts/e2e-scenarios <a|b|c>}"
cd "$(dirname "$0")/.."
source tests/e2e/env.sh

COMPOSE_FILE="tests/e2e/compose.yaml"
# MOLIGHT_E2E_RUN_ROOT pins where the run directory is made (CI uploads it on
# failure). Each run makes its own there, so nothing else in it is touched.
RUN_PARENT="${MOLIGHT_E2E_RUN_ROOT:-${TMPDIR:-/tmp}}"
mkdir -p "$RUN_PARENT"
RUN_PARENT="$(cd "$RUN_PARENT" && pwd)"  # compose resolves relative mounts elsewhere
RUN_ROOT="$(mktemp -d "$RUN_PARENT/molight-e2e-scenarios-$SHARD.XXXXXX")"
export MOLIGHT_E2E_CONFIG_DIR="$RUN_ROOT/config"
export COMPOSE_PROJECT_NAME="molight-e2e-scenarios-$SHARD-$$"
mkdir -p "$MOLIGHT_E2E_CONFIG_DIR"
cp tests/e2e/configuration.yaml "$MOLIGHT_E2E_CONFIG_DIR/configuration.yaml"

compose() {
    docker compose --file "$COMPOSE_FILE" "$@"
}

cleanup() {
    status=$?
    set +e
    compose logs --no-color > "$RUN_ROOT/docker-compose.log" 2>&1
    compose down --volumes --remove-orphans >/dev/null 2>&1
    if [ "$status" -eq 0 ]; then
        remove_dirs "$RUN_ROOT"
    else
        echo ""
        echo "E2E scenarios failure artifacts retained at: $RUN_ROOT"
        echo "The config contains the isolated test account; delete it after debugging."
    fi
    exit "$status"
}
trap cleanup EXIT
# Exit on a signal so the EXIT trap cleans up once, and never reports a pass.
trap 'exit 130' INT
trap 'exit 143' TERM

echo "Starting isolated Home Assistant for behaviour scenario shard $SHARD..."
compose up --detach homeassistant

echo "Running behaviour scenario shard $SHARD..."
compose run --rm runner python runner.py "scenarios-$SHARD"
check_ha_logs 1

echo "MoLight E2E behaviour scenario shard $SHARD passed."

#!/usr/bin/env bash
set -Eeuo pipefail

cd "$(dirname "$0")/.."
source tests/e2e/env.sh

COMPOSE_FILE="tests/e2e/compose.yaml"
RUN_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/molight-e2e.XXXXXX")"
export MOLIGHT_E2E_CONFIG_DIR="$RUN_ROOT/config"
export COMPOSE_PROJECT_NAME="molight-e2e-$$"
mkdir -p "$MOLIGHT_E2E_CONFIG_DIR"
cp tests/e2e/configuration.yaml "$MOLIGHT_E2E_CONFIG_DIR/configuration.yaml"

compose() {
    docker compose --file "$COMPOSE_FILE" "$@"
}

cleanup() {
    status=$?
    set +e
    compose logs --no-color > "$RUN_ROOT/docker-compose.log" 2>&1
    compose down --volumes --remove-orphans >/dev/null 2>&1
    if [ "$status" -eq 0 ]; then
        rm -rf "$RUN_ROOT"
    else
        echo ""
        echo "E2E failure artifacts retained at: $RUN_ROOT"
        echo "The config contains the isolated test account; delete it after debugging."
    fi
    exit "$status"
}
trap cleanup EXIT INT TERM

echo "Starting isolated Home Assistant (${MOLIGHT_E2E_HA_IMAGE:-2026.8.0})..."
compose up --detach homeassistant

echo "Running live API acceptance scenarios..."
compose run --rm runner python runner.py primary

echo "Restarting the full Home Assistant container..."
compose restart homeassistant
compose run --rm runner python runner.py restart

echo "Preparing a restart with the physical light unavailable..."
compose run --rm runner python runner.py unavailable-light-prepare
compose restart homeassistant
compose run --rm runner python runner.py unavailable-light-recover

echo "Restarting with occupancy and schedule sources unavailable..."
compose restart homeassistant
compose run --rm runner python runner.py unavailable-sensors-motion-first

echo "Restarting to recover the unavailable sensors in reverse order..."
compose restart homeassistant
compose run --rm runner python runner.py unavailable-sensors-schedule-first

echo "Disabling auto-off and preparing its restart-persistence check..."
compose run --rm runner python runner.py auto-off-prepare
compose restart homeassistant
compose run --rm runner python runner.py auto-off-restart

echo "Restarting during a live warning stage..."
compose run --rm runner python runner.py restart-warning-prepare
compose restart homeassistant
compose run --rm runner python runner.py restart-warning-verify

echo "Restarting with occupancy in progress under false-detection grace..."
compose run --rm runner python runner.py false-detection-prepare
compose restart homeassistant
compose run --rm runner python runner.py false-detection-verify

echo "Restarting with an occupancy source that loads late..."
compose run --rm runner python runner.py late-source-prepare
compose restart homeassistant
compose run --rm runner python runner.py late-source-verify

echo "Restarting across a follow-mode window start..."
compose run --rm runner python runner.py follow-restart-prepare
compose restart homeassistant
compose run --rm runner python runner.py follow-restart-verify
compose restart homeassistant
compose run --rm runner python runner.py follow-restart-verify-off

echo "Restarting across a scheduled light's turn_off window end..."
compose run --rm runner python runner.py end-restart-prepare
compose restart homeassistant
compose run --rm runner python runner.py end-restart-verify

echo "Checking Home Assistant logs..."
compose run --rm runner python runner.py logs

echo "MoLight E2E acceptance suite passed."

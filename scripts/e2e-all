#!/usr/bin/env bash
# Run every e2e lane concurrently: the core restart chain, the independent
# restart scenarios, and the behaviour scenario shards.
set -Eeuo pipefail

cd "$(dirname "$0")/.."

prefix() {
    while IFS= read -r line; do printf '[%s] %s\n' "$1" "$line"; done
}

lane_root() {
    # Give each lane its own run directory when a shared one is requested.
    if [ -n "${MOLIGHT_E2E_RUN_ROOT:-}" ]; then
        echo "${MOLIGHT_E2E_RUN_ROOT}/$1"
    fi
}

pids=()
MOLIGHT_E2E_RUN_ROOT="$(lane_root core)" bash scripts/e2e 2>&1 | prefix core &
pids+=($!)
MOLIGHT_E2E_RUN_ROOT="$(lane_root restarts)" bash scripts/e2e-restarts 2>&1 | prefix restarts &
pids+=($!)
for shard in a b c; do
    MOLIGHT_E2E_RUN_ROOT="$(lane_root "scenarios-$shard")" \
        bash scripts/e2e-scenarios "$shard" 2>&1 | prefix "scenarios-$shard" &
    pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
    wait "$pid" || status=1
done
if [ "$status" -eq 0 ]; then
    echo "MoLight E2E suites passed."
fi
exit "$status"

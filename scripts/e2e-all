#!/usr/bin/env bash
# Run every e2e lane concurrently: the core restart chain, the independent
# restart scenarios, and the behaviour scenario shards.
set -Eeuo pipefail

cd "$(dirname "$0")/.."

prefix() {
    while IFS= read -r line; do printf '[%s] %s\n' "$1" "$line"; done
}

# Lanes run in the background, where SIGINT is ignored, so pass an interrupt
# on to them as TERM and wait while they clean up.
interrupt() {
    trap '' INT TERM
    for pid in $(jobs -p); do kill -TERM "$pid" 2>/dev/null || true; done
    wait
    exit "$1"
}
on_int() { interrupt 130; }
on_term() { interrupt 143; }
trap on_int INT
trap on_term TERM

pids=()
bash scripts/e2e 2>&1 | prefix core &
pids+=($!)
bash scripts/e2e-restarts 2>&1 | prefix restarts &
pids+=($!)
for shard in a b c; do
    bash scripts/e2e-scenarios "$shard" 2>&1 | prefix "scenarios-$shard" &
    pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
    wait "$pid" || status=1
done
if [ "$status" -ne 0 ]; then
    exit "$status"
fi
echo "MoLight E2E suites passed."

#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

# Prefer IPv4: this container has no working IPv6 egress, and pip/Python
# (unlike curl) don't do Happy Eyeballs — they block on the dead IPv6 route
# until it times out on every connection, throttling downloads to a crawl.
# Making getaddrinfo return IPv4 first avoids the stall.
GAI_RULE='precedence ::ffff:0:0/96  100'
if ! grep -qxF "$GAI_RULE" /etc/gai.conf 2>/dev/null; then
  echo "$GAI_RULE" >> /etc/gai.conf
fi

# Venv lives inside the container filesystem, not the mounted workspace
# (macOS-mounted volumes don't support Python venv symlinks reliably)
VENV=/opt/molight-venv

echo "▶ Creating virtual environment at $VENV..."
python3 -m venv "$VENV"

echo "▶ Installing dependencies..."
"$VENV/bin/pip" install -r requirements_test.txt

echo "▶ Pre-installing Home Assistant runtime dependencies..."
CONSTRAINTS="$("$VENV/bin/python" -c 'import homeassistant, os; print(os.path.dirname(homeassistant.__file__))')/package_constraints.txt"

# Packages HA lazily installs at runtime but we need upfront to avoid hangs/crashes
RUNTIME_PACKAGES=(
  home-assistant-frontend
  hassil
  home-assistant-intents
)

for PKG in "${RUNTIME_PACKAGES[@]}"; do
  VERSION=$(grep "^${PKG}==" "$CONSTRAINTS" | cut -d= -f3)
  if [ -n "$VERSION" ]; then
    "$VENV/bin/pip" install "${PKG}==${VERSION}"
    echo "  ${PKG}==${VERSION}"
  else
    echo "  WARNING: ${PKG} not found in constraints, skipping"
  fi
done

echo ""
echo "✅ Dev environment ready!"
echo ""

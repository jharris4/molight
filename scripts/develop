#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

VENV=/opt/molight-venv
PYTHON="$VENV/bin/python"

bash scripts/ensure-venv

# Stop any existing HA and wait until it exits, so it no longer holds its instance lock
HA_PATTERN="python.*-m homeassistant"
if pkill -f "$HA_PATTERN" 2>/dev/null; then
    deadline=$((SECONDS + 60))
    while pgrep -f "$HA_PATTERN" >/dev/null; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "The previous Home Assistant is still shutting down after 60 s; try again shortly." >&2
            exit 1
        fi
        sleep 0.5
    done
fi

# Init config dir if needed
mkdir -p config
"$PYTHON" -m homeassistant --config "${PWD}/config" --script ensure_config

# Put our custom_components on the Python path so HA finds them
export PYTHONPATH="${PWD}/custom_components:${PYTHONPATH}"

"$PYTHON" -m homeassistant --config "${PWD}/config" -v

{
  "name": "limer",
  "private": true,
  "scripts": {
    "hass": "docker compose up",
    "hass:down": "docker compose down",
    "up": "devcontainer up --workspace-folder .",
    "rebuild": "devcontainer up --workspace-folder . --remove-existing-container",
    "shell": "devcontainer exec --workspace-folder . bash",
    "test": "devcontainer exec --workspace-folder . /opt/limer-venv/bin/pytest"
  },
  "devDependencies": {
    "@devcontainers/cli": "^0.75.0"
  }
}
